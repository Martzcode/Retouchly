{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retouchly",
  "version": "0.1.0",
  "identifier": "com.retouchly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/retouchly/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Retouchly",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Martzcode",
    "copyright": "Copyright © 2026 Martzcode. All rights reserved.",
    "category": "Graphics and Design",
    "shortDescription": "Open source image editor",
    "longDescription": "Retouchly is a lightweight, open source image editor with layers, adjustments and effects — inspired by Paint.NET.",
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "exceptionDomain": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
